    "@types/geojson": "7946.0.14",
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "mapshaper": "0.6.99",
    "tsx": "4.19.2",
